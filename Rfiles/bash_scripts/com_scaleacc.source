#com_scaleacc
#Author: Nancy.Y.Kiang@nasa.gov
#Generate scaleacc files.
#To run:
# source com_scaleacc.source <RUN> <ACCDIR>

RUN=$1
ACCDIR=$2
xijkl=$3
NMONAV=$4
YR1=$5
YR2=$6

if [ $# -eq 0 ] || [ $RUN == '' ] || [ $ACCDIR == '' ] || [ $xijkl == '' ] || [ $NMONAV == '' ] || [ $YR1 == '' ] || [ $YR2 == '' ]; then
echo "com_scaleacc: Generate scaleacc files. ";
echo "Outputs are written to directory from which this script is called.";
echo " Inputs:";
echo "RUN = run name";
echo "ACCDIR = directory with acc files";
echo "xijkl = <scaleacc option, e.g. aij, gij, lakij, aijl, etc. >";
echo "NMONAV = < MON | SEASON | YEAR | MONPER | SEASONPER | YEARPER >";
echo "YR1 = first year";
echo "YR2 = last year";
echo "where MON, SEASON, YEAR are options for specific years from YR1 to YR2,";
echo "and MONPER, SEASONPER, YEARPER are options for period averages over YR1-YR2.";
echo " ";

  return;
fi

echo 'RUN: '$RUN;
echo 'ACCDIR: '$ACCDIR;
echo 'xijkl: '$xijkl;
echo 'NMONAV: '$NMONAV;
echo 'YR1: '$YR1;
echo 'YR2: '$YR1;

#-------------------------------------------------------------------------------

OUTDIR=''

MON=(JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC)
SEASON=(DJF MAM JJA SON)

#-------------
#Monthly 
if [ $NMONAV == 'MON' ]; then
echo 'scaling monthly files';

y=$YR1
while [ $y -le $YR2 ]; do
 k=0
 while [ $k -lt 12 ]; do
   ls $ACCDIR/${MON[$k]}${y}".acc"$RUN".nc"
   scaleacc $ACCDIR/${MON[$k]}${y}".acc"$RUN".nc" $xijkl
   let k=k+1
 done
 let y=y+1
done
fi
return;

#-------------
#Monthly decadal
if [ $NMONAV == 'MONPER' ]; then
k=0
while [ $k -lt 12 ]; do
  echo   ../ACC/${MON[$k]}${YR1}"0-"${YR2}".acc"$RUN".nc"
  scaleacc ../ACC/${MON[$k]}${YR1}"0-"${YR2}".acc"$RUN".nc" $xijkl
 let k=k+1
done
fi

#**** NOT FINISHED WITH THE BELOW ****
if false; then
#------------
#Seasonal decadal:  1981-1989, because do not have DEC1979
if [ $NMONAV == 'SEASONPER' ]; then
cd aij
s=0
n=198
 ls       ../ACC/${SEASON[$s]}${n}"1-"${n}"9.acc"$RUN".nc"
 scaleacc ../ACC/${SEASON[$s]}${n}"1-"${n}"9.acc"$RUN".nc" aij
 let s=s+1
 while [ $s -lt 4 ]; do
  ls       ../ACC/${SEASON[$s]}${n}"0-"${n}"9.acc"$RUN".nc"
  scaleacc ../ACC/${SEASON[$s]}${n}"0-"${n}"9.acc"$RUN".nc" aij
  let s=s+1
 done
fi

#Seasonal decadal: 1990-2019
cd aij
#n=199
# while [ $n -le 200 ]; do
n=201
 while [ $n -le 201 ]; do
  s=0
 while [ $s -lt 4 ]; do
  ls       ../ACC/${SEASON[$s]}${n}"0-"${n}"9.acc"$RUN".nc"
  scaleacc ../ACC/${SEASON[$s]}${n}"0-"${n}"9.acc"$RUN".nc" aij
  let s=s+1
 done
 let n=n+1
done

#Annual decadal
cd aij
n=198
while [ $n -le 201 ]; do
  ls       ../ACC/ANN${n}"0-"${n}"9.acc"$RUN".nc"
  scaleacc ../ACC/ANN${n}"0-"${n}"9.acc"$RUN".nc" aij
  let n=n+1
done

# * tar gzip * #

cd aij
#tar cf ${RUN}.ANN.DECADES.1980-2019.tar ANN*-*
f=${RUN}.ANN.DECADES.1980-2019.tar
echo $f
tar cf ${f} ANN*-*
gzip ${f}
#mv ${f}".gz" ${OUTDIR}/${RUN}

#tar cf ${RUN}.SEASONS.DECADES.1980-2019.tar DJF* MAM* JJA* SON*
f=${RUN}.SEASONS.DECADES.1980-2019.tar
echo ${f}
tar cf ${f} DJF* MAM* JJA* SON*
gzip ${f}
#mv ${f}".gz" ${OUTDIR}/${RUN}

#tar cf ${RUN}.MONTH.DECADES.1980-2019.tar JAN*-* FEB*-* MAR*-* APR*-* MAY*-* JUN*-* JUL*-* AUG*-* SEP*-* OCT*-* NOV*-* DEC*-*
f=${RUN}.MONTH.DECADES.1980-2019.tar
echo ${f}
tar cf ${f} JAN*-* FEB*-* MAR*-* APR*-* MAY*-* JUN*-* JUL*-* AUG*-* SEP*-* OCT*-* NOV*-* DEC*-*
gzip ${f}
#mv ${f}".gz" ${OUTDIR}/${RUN}

fi

