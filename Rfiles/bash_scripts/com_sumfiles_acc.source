#com_sumfiles_acc.source

#RUN=E151OCNf10aF40_2nkngs2
RUN=$1
YR1=$2
YR2=$3

if [ $# -eq 0 ]; then
  echo 'Outputs to directory where called.'
  echo 'Usage:  source $R_Ent/bash_scripts/com_sumfiles_acc.source <run name>';
  return;
fi


MON=(JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC)

if true; then
#-------------------------------------------- 
#Month decadal
cd ACC
k=0
while [ $k -lt 12 ]; do
 n=198
 while [ $n -le 201 ]; do
  #echo JAN198[0-9].acc$RUN".nc"
  echo ${MON[$k]}${n}[0-9].acc$RUN".nc"
  sumfiles ${MON[$k]}${n}[0-9].acc$RUN".nc"
  let n=n+1
 done
 let k=k+1
done
cd ..

#Seasonal decadal, each decade:  1980-1989, 1990-1999, 2000-2009, 2010-2019.
cd ACC
n=198
while [ $n -le 201 ]; do
  let k=n-1
  echo DEC${k}9.acc$RUN".nc" DEC${n}[0-8].acc$RUN".nc" JAN${n}[0-9].acc$RUN".nc" FEB${n}[0-9].acc$RUN".nc"
  echo MAR${n}[0-9].acc$RUN".nc" APR${n}[0-9].acc$RUN".nc" MAY${n}[0-9].acc$RUN".nc"
  echo JUN${n}[0-9].acc$RUN".nc" JUL${n}[0-9].acc$RUN".nc" AUG${n}[0-9].acc$RUN".nc"
  echo SEP${n}[0-9].acc$RUN".nc" OCT${n}[0-9].acc$RUN".nc" NOV${n}[0-9].acc$RUN".nc"
  sumfiles DEC${k}9.acc$RUN".nc" DEC${n}[0-8].acc$RUN".nc" JAN${n}[0-9].acc$RUN".nc" FEB${n}[0-9].acc$RUN".nc"
  sumfiles MAR${n}[0-9].acc$RUN".nc" APR${n}[0-9].acc$RUN".nc" MAY${n}[0-9].acc$RUN".nc"
  sumfiles JUN${n}[0-9].acc$RUN".nc" JUL${n}[0-9].acc$RUN".nc" AUG${n}[0-9].acc$RUN".nc"
  sumfiles SEP${n}[0-9].acc$RUN".nc" OCT${n}[0-9].acc$RUN".nc" NOV${n}[0-9].acc$RUN".nc"
  let n=n+1
 done
cd ..
#--------------------------------------------
fi

#Annual decadal
cd ann
n=198
#while [ $n -le 198 ]; do
while [ $n -le 201 ]; do
  echo ANN${n}[0-9].acc$RUN".nc"
  sumfiles ANN${n}[0-9].acc$RUN".nc"
  let n=n+1
done
cd ..


